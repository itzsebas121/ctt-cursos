# ==============================================================================
# CONFIGURACIÓN GENERAL DEL MONOREPO CTT (.env.example)
# Copia este archivo como .env para personalizar tus variables de entorno:
# cp .env.example .env
# ==============================================================================

# ── Puertos Expuestos en el Host ──────────────────────────────────────────────
# NOTA: Los navegadores como Google Chrome y Mozilla Firefox bloquean el puerto 6000
# por defecto con el error ERR_UNSAFE_PORT (reservado históricamente para X11).
# Si tu navegador bloquea el 6000, puedes cambiar WEB_PORT a 5000 o 3000.
WEB_PORT=6000
ADMIN_PORT=6001
API_PORT=6002
POSTGRES_EXTERNAL_PORT=6003

# ── Base de Datos PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=ctt_db
POSTGRES_USER=ctt_app
POSTGRES_PASSWORD=ctt_secret_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Backend FastAPI ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=clave_secreta_jwt_ctt_super_segura_2026_dev
DEBUG=True
BACKEND_URL=http://localhost:6002
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000,http://localhost:6000,http://localhost:6001,http://localhost:6002,http://127.0.0.1:3000,http://127.0.0.1:5000,http://127.0.0.1:6000,http://127.0.0.1:6001,http://127.0.0.1:6002

# ── Frontend API URL (Para compilación Vite) ──────────────────────────────────
# Esta es la URL a la que el navegador del cliente se comunicará con el backend
VITE_API_URL=http://localhost:6002/api/v1

