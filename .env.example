# ==============================================================================
# CONFIGURACIÓN GENERAL DEL MONOREPO CTT (.env.example)
# ==============================================================================

# ── Puertos Expuestos en el Host ──────────────────────────────────────────────
# Usamos la serie 3000 sucesiva (evita ERR_UNSAFE_PORT de Chrome en el puerto 6000)
WEB_PORT=3000
ADMIN_PORT=3001
API_PORT=3002
POSTGRES_EXTERNAL_PORT=3003

# ── Base de Datos PostgreSQL ──────────────────────────────────────────────────
POSTGRES_DB=ctt_db
POSTGRES_USER=ctt_app
POSTGRES_PASSWORD=ctt_secret_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Backend FastAPI ───────────────────────────────────────────────────────────
JWT_SECRET_KEY=clave_secreta_jwt_ctt_super_segura_2026_dev
DEBUG=True
BACKEND_URL=http://localhost:3002
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://127.0.0.1:3000,http://127.0.0.1:3001,http://127.0.0.1:3002

# ── Frontend API URL (Para compilación y desarrollo Vite) ─────────────────────
VITE_API_URL=http://localhost:3002/api/v1
